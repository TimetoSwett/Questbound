generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
  output        = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String               @id @default(cuid())
  email           String               @unique
  password        String
  displayName     String               @default("Adventurer")
  emailVerified   DateTime?
  image           String?
  accounts        Account[]
  sessions        Session[]
  memberships     CampaignMembership[]
  characters      Character[]
  diceRolls       DiceRoll[]
  creatureReveals CreatureReveal[]
  isAdmin         Boolean              @default(false)
  libraryEntries  LibraryEntry[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Campaign {
  id          String   @id @default(cuid())
  name        String
  description String?  @default("")
  inviteCode  String   @unique
  dmUserId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships           CampaignMembership[]
  characters            Character[]
  wikiPages             WikiPage[]
  worldMapImage         String?
  worldMapImageIsPublic Boolean              @default(true)
  worldMapPins          WorldMapPin[]
  battleMapState        Json?                @default("{\"gridWidth\":20,\"gridHeight\":20,\"tokens\":[],\"highlights\":[],\"fog\":[]}")
  battleMapVersion      Int                  @default(0) // optimistic-concurrency counter for battleMapState
  regionNodes           RegionNode[]
  regionEdges           RegionEdge[]
  creatures             Creature[]
  diceRolls             DiceRoll[]
  towns                 Town[]
  partyCp               Int                  @default(0) // party coin total in copper (1 gp = 100 cp)
  sharedPurse           Boolean              @default(false) // DM-only: when true, gp/pp come from partyCp; sp/cp stay per character
  inventoryItems        InventoryItem[]
  lootTables            LootTable[]
}

model CampaignMembership {
  id         String   @id @default(cuid())
  userId     String
  campaignId String
  role       String   @default("player") // "dm" or "player"
  joinedAt   DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([userId, campaignId])
}

model Character {
  id         String  @id @default(cuid())
  userId     String
  campaignId String?
  name       String  @default("New Character")

  // Portrait
  portraitPath     String?
  portraitIsPublic Boolean @default(true)

  // Core info
  race      String @default("")
  alignment String @default("")
  deity     String @default("")
  size      String @default("Medium")
  gender    String @default("")
  age       String @default("")
  height    String @default("")
  weight    String @default("")
  homeland  String @default("")
  xp        Int    @default(0)
  speed     Int    @default(30)

  // Classes: [{name, level}]
  classes Json @default("[]")

  // Core Ability Scores
  str Int @default(10)
  dex Int @default(10)
  con Int @default(10)
  int Int @default(10)
  wis Int @default(10)
  cha Int @default(10)

  // HP
  hpMax     Int @default(0)
  hpCurrent Int @default(0)
  hpTemp    Int @default(0)

  // Combat
  bab Int @default(0)
  sr  Int @default(0)

  // Saving throws base
  baseFort Int @default(0)
  baseRef  Int @default(0)
  baseWill Int @default(0)
  miscFort Int @default(0)
  miscRef  Int @default(0)
  miscWill Int @default(0)

  // AC components
  armorBonus   Int @default(0)
  shieldBonus  Int @default(0)
  naturalArmor Int @default(0)
  deflection   Int @default(0)
  sizeMod      Int @default(0)
  miscAC       Int @default(0)
  miscTouchAC  Int @default(0)
  miscFlatAC   Int @default(0)

  // CMD/CMB misc
  miscCMD Int @default(0)
  miscCMB Int @default(0)

  // Initiative misc
  miscInit Int @default(0)

  // Skills: [{name, ranks, classSkill, misc}]
  skills Json @default("[]")

  // Equipment: [{name, weight, quantity, value, notes}]
  equipment Json @default("[]")
  // Equipped gear (see lib/equipment.ts for the shape): armor, shield,
  // weapons, the 14 body slots and 2 unslotted slots. Armor/shield feed
  // armorBonus/shieldBonus, max Dex, armor check penalty and spell failure.
  equipped  Json @default("{}")

  // Feats: [{name, description}]
  feats Json @default("[]")

  // Spells: {slots: {0:n,1:n,...}, known: [{name,level,school,description,cast,maxCast}]}
  spells Json @default("{\"slots\":{},\"known\":[]}")

  // Notes / Backstory (TipTap HTML)
  notes String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaign       Campaign?       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  // Optional link back to the Bestiary NPC this sheet was upgraded from.
  creatureId     String?         @unique
  creature       Creature?       @relation("CharacterCreature", fields: [creatureId], references: [id], onDelete: SetNull)
  inventoryItems InventoryItem[]

  // Companion sheets (animal companion, familiar, eidolon...) point at their owner
  // sheet. Visibility is NOT inherited through this link; see lib/companions.ts.
  ownerCharacterId String?
  owner            Character?  @relation("CharacterCompanions", fields: [ownerCharacterId], references: [id], onDelete: SetNull)
  companions       Character[] @relation("CharacterCompanions")
  companionType    String      @default("")

  @@index([campaignId])
  @@index([userId])
  @@index([ownerCharacterId])
}

model WikiPage {
  id         String   @id @default(cuid())
  campaignId String
  title      String
  category   String   @default("Lore") // NPC, Location, Faction, Lore, Item
  body       String   @default("")
  visibility String   @default("dm_only") // dm_only or shared
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  campaign  Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  pins      WorldMapPin[]
  creatures Creature[]
  towns     Town[]

  @@index([campaignId])
}

model WorldMapPin {
  id          String   @id @default(cuid())
  campaignId  String
  x           Float
  y           Float
  label       String
  description String   @default("")
  category    String   @default("POI") // City, Dungeon, Wilderness, POI
  visibility  String   @default("dm_only") // dm_only or shared
  createdAt   DateTime @default(now())
  wikiPageId  String?

  campaign Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  wikiPage WikiPage? @relation(fields: [wikiPageId], references: [id], onDelete: SetNull)
  towns    Town[]

  @@index([campaignId])
}

model RegionNode {
  id          String   @id @default(cuid())
  campaignId  String
  name        String
  description String   @default("")
  nodeType    String   @default("city") // city, dungeon, wilderness, town, fort, poi
  x           Float    @default(100)
  y           Float    @default(100)
  visibility  String   @default("dm_only") // dm_only or shared
  createdAt   DateTime @default(now())

  campaign  Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  edgesFrom RegionEdge[] @relation("edgeFrom")
  edgesTo   RegionEdge[] @relation("edgeTo")

  @@index([campaignId])
}

model RegionEdge {
  id         String @id @default(cuid())
  campaignId String
  fromNodeId String
  toNodeId   String
  label      String @default("")

  campaign Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  fromNode RegionNode @relation("edgeFrom", fields: [fromNodeId], references: [id], onDelete: Cascade)
  toNode   RegionNode @relation("edgeTo", fields: [toNodeId], references: [id], onDelete: Cascade)

  @@index([campaignId])
}

// Bestiary / NPC stat block owned by a campaign. GM-managed; players only ever
// see a basic card for creatures whose revealLevel is not "hidden" (see lib/creatures.ts).
model Creature {
  id         String  @id @default(cuid())
  campaignId String
  name       String  @default("New Creature")
  type       String  @default("") // e.g. Humanoid, Undead
  subtype    String  @default("") // e.g. Goblinoid
  cr         String  @default("") // string to allow fractional CRs like "1/2"
  alignment  String  @default("")
  size       String  @default("Medium")
  isNpc      Boolean @default(false)

  // Portrait (upload key/path, same as Character.portraitPath)
  portraitPath String?

  // AC
  acTotal      Int @default(10)
  acTouch      Int @default(10)
  acFlatFooted Int @default(10)

  // HP
  hpMax     Int    @default(0)
  hpCurrent Int    @default(0)
  hitDice   String @default("") // e.g. "3d8+6"

  // Saves
  fort Int @default(0)
  ref  Int @default(0)
  will Int @default(0)

  // Ability scores (nullable: some creatures have "-" for a score)
  str Int? @default(10)
  dex Int? @default(10)
  con Int? @default(10)
  int Int? @default(10)
  wis Int? @default(10)
  cha Int? @default(10)

  speed Int @default(30)

  // Attacks: [{name, bonus, damage, critical, type, notes}]
  attacks          Json @default("[]")
  // Skills: [{name, bonus, notes}]
  skills           Json @default("[]")
  // Feats: [{name, description}]
  feats            Json @default("[]")
  // Special abilities: [{name, type, description}]
  specialAbilities Json @default("[]")
  // Spells: {slots: {0:n,...}, known: [{name,level,school,description,cast,maxCast}]}
  spells           Json @default("{\"slots\":{},\"known\":[]}")
  // Gear: [{name, weight, quantity, value, notes}]
  gear             Json @default("[]")

  wikiPageId String?

  gmNotes          String           @default("")
  // Player-facing notes (weaknesses, rumors) — visible when the playerNotes
  // section is unlocked (named) or everything is revealed (full). gmNotes is GM-only.
  playerNotes      String           @default("")
  // Party-wide visibility only: "hidden" keeps the creature out of every
  // player's Bestiary; any other value (new writes use "unknown") lists it.
  // What each player can READ is per player, in CreatureReveal.
  revealLevel      String           @default("hidden")
  // DEPRECATED, no longer read: the old party-wide unlocks. Copied into
  // CreatureReveal by prisma/sql/2026-10-19_per_player_creature_reveals.sql,
  // which then empties it. Kept so `prisma db push` can't drop it before that
  // copy runs; remove in a later change.
  unlockedSections Json             @default("[]")
  reveals          CreatureReveal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaign Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  wikiPage WikiPage? @relation(fields: [wikiPageId], references: [id], onDelete: SetNull)

  residences  TownResident[]
  characters  Character[]    @relation("CharacterCreature")
  shopkeeping TownPlace[]    @relation("PlaceShopkeeper")
  // Loot: an optional weighted table, plus a fixed list of guaranteed drops
  // [{name, quantity, valueGp, weight, notes}].
  lootTableId String?
  lootTable   LootTable?     @relation(fields: [lootTableId], references: [id], onDelete: SetNull)
  lootList    Json           @default("[]")

  @@index([campaignId])
}

// Shared dice roll log per campaign. Rolls are made on the server so results
// can't be faked; the log is visible to all campaign members (secret rolls
// only to the DM).
model DiceRoll {
  id         String   @id @default(cuid())
  campaignId String
  userId     String
  // Display name captured at roll time.
  userName   String   @default("Adventurer")
  // Normalized expression, e.g. "2d20+5".
  expression String
  // Individual die results, e.g. [14, 7].
  results    Json     @default("[]")
  total      Int
  // GM secret rolls: returned only to the DM.
  isSecret   Boolean  @default(false)
  createdAt  DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([campaignId, createdAt])
}

// Towns per campaign, with the same reveal controls as creatures
// (revealLevel + unlockedSections, scrambled server-side; gmNotes never
// sent to players).
model Town {
  id               String  @id @default(cuid())
  campaignId       String
  name             String
  // PF1e settlement size: thorp, hamlet, village, small town, large town,
  // small city, large city, metropolis
  size             String  @default("village")
  population       Int?
  government       String  @default("")
  description      String  @default("")
  // GM-only notes, never sent to players.
  gmNotes          String  @default("")
  // Reveal controls, same semantics as creatures: hidden | unknown | named | full
  revealLevel      String  @default("hidden")
  unlockedSections Json    @default("[]")
  wikiPageId       String?
  mapPinId         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaign  Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  wikiPage  WikiPage?      @relation(fields: [wikiPageId], references: [id], onDelete: SetNull)
  mapPin    WorldMapPin?   @relation(fields: [mapPinId], references: [id], onDelete: SetNull)
  residents TownResident[]
  places    TownPlace[]

  @@index([campaignId])
}

// Resident NPCs pulled from the Bestiary. A creature can belong to at most
// one town (enforced by the unique creatureId).
model TownResident {
  id          String @id @default(cuid())
  townId      String
  creatureId  String @unique
  // The NPC's role in the town, e.g. "Innkeeper".
  role        String @default("")
  // Disposition toward the party, e.g. "Friendly".
  disposition String @default("")

  town     Town     @relation(fields: [townId], references: [id], onDelete: Cascade)
  creature Creature @relation(fields: [creatureId], references: [id], onDelete: Cascade)

  @@index([townId])
}

// Shops and notable places in a town.
model TownPlace {
  id           String  @id @default(cuid())
  townId       String
  name         String
  type         String  @default("")
  description  String  @default("")
  // Optional shopkeeper linked to a Bestiary NPC.
  shopkeeperId String?
  // GM-only notes, never sent to players.
  gmNotes      String  @default("")
  // "hidden" | "revealed" — hidden places are invisible to players.
  revealLevel  String  @default("hidden")

  town       Town      @relation(fields: [townId], references: [id], onDelete: Cascade)
  shopkeeper Creature? @relation("PlaceShopkeeper", fields: [shopkeeperId], references: [id], onDelete: SetNull)

  @@index([townId])
}

// Party loot. characterId null = carried by the party; otherwise by that
// character (deleting the character returns the item to the party).
model InventoryItem {
  id          String   @id @default(cuid())
  campaignId  String
  characterId String?
  name        String
  quantity    Int      @default(1)
  valueGp     Float    @default(0) // per unit
  weight      Float    @default(0) // lb per unit
  notes       String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  campaign  Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  character Character? @relation(fields: [characterId], references: [id], onDelete: SetNull)

  @@index([campaignId])
  @@index([characterId])
}

model LootTable {
  id         String   @id @default(cuid())
  campaignId String
  name       String
  rolls      Int      @default(1) // entries drawn per "Roll loot"
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  campaign  Campaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  entries   LootTableEntry[]
  creatures Creature[]

  @@index([campaignId])
}

// One weighted row. kind "item" adds an InventoryItem; kind "coins" adds
// the rolled amount (quantity dice x valueGp) to Campaign.partyCp.
model LootTableEntry {
  id       String @id @default(cuid())
  tableId  String
  kind     String @default("item") // "item" | "coins"
  name     String @default("")
  chance   Int    @default(1) // relative weight
  quantity String @default("1") // dice expression, e.g. "1d4" or "3"
  valueGp  Float  @default(0)
  weight   Float  @default(0)
  notes    String @default("")
  sort     Int    @default(0)

  table LootTable @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@index([tableId])
}

// Shared site-wide library (spells first; later feats/items/classes).
model LibraryEntry {
  id          String       @id @default(cuid())
  kind        String
  name        String
  nameKey     String
  system      String       @default("pf1e")
  source      String       @default("user")
  sourceUrl   String?
  matchedAon  Boolean      @default(false)
  summary     String       @default("")
  data        Json
  createdById String?
  createdBy   User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  spellLevels SpellLevel[]

  @@unique([kind, system, nameKey])
}

model SpellLevel {
  entryId String
  cls     String
  level   Int
  entry   LibraryEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@id([entryId, cls])
  @@index([cls, level])
}

// What one player has learned about one Bestiary creature (e.g. from a
// Knowledge roll). The GM grants and revokes these per player; players only
// ever receive the sections in their own row. No row = nothing unlocked.
model CreatureReveal {
  id         String   @id @default(cuid())
  creatureId String
  userId     String
  // Unlocked section keys (lib/creatures.ts REVEAL_SECTIONS): name, defense,
  // offense, statistics, specialAbilities, playerNotes, wiki
  sections   Json     @default("[]")
  // Everything, including type/size/CR/alignment (the old "full" level)
  full       Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  creature Creature @relation(fields: [creatureId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([creatureId, userId])
  @@index([userId])
}
